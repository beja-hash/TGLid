APP_ENV=development
APP_NAME=TGLid API
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=postgresql+asyncpg://tglid:local-development-password@postgres:5432/tglid
TEST_DATABASE_URL=postgresql+asyncpg://tglid:local-development-password@postgres:5432/tglid_test
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_CSRF_COOKIE_NAME=tglid_csrf
NEXT_PUBLIC_CSRF_HEADER_NAME=X-CSRF-Token
POSTGRES_DB=tglid
POSTGRES_USER=tglid
POSTGRES_PASSWORD=local-development-password
SESSION_COOKIE_NAME=tglid_session
SESSION_TTL_HOURS=24
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_DOMAIN=
CSRF_COOKIE_NAME=tglid_csrf
CSRF_HEADER_NAME=X-CSRF-Token
LOGIN_RATE_LIMIT_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
PASSWORD_MIN_LENGTH=10
SESSION_RETENTION_DAYS=30
SESSION_LAST_SEEN_UPDATE_MINUTES=5
TRUSTED_PROXY_COUNT=0
